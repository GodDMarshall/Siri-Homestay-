# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=3000
# Public address of the site, no trailing slash. Used in emails, sitemap and social previews.
SITE_URL=https://sirihomestay.in
# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Set to 1 when running behind Nginx, Caddy, Cloudflare or a platform proxy (needed for correct client IPs and HTTPS cookies).
TRUST_PROXY=1
# Where the SQLite database lives. Back this folder up.
DATA_DIR=./data
# 1 when stored data won't last (on by default on Vercel): enquiries become a WhatsApp message
# for the guest to send instead of being saved, and the calendar is never shown as live.
# TEMPORARY_STORAGE=0

# First admin account (used only when no admin exists yet).
ADMIN_EMAIL=owner@sirihomestay.in
# Leave empty to generate a random temporary password (written to DATA_DIR/INITIAL-ADMIN-LOGIN.txt).
ADMIN_PASSWORD=

# Email for enquiry notifications. Leave SMTP_HOST empty to keep email off.
# Gmail: use smtp.gmail.com, port 465, SMTP_SECURE=1 and an App Password (Google account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Siri Homestay <sirihomestayjoldhal@gmail.com>"
