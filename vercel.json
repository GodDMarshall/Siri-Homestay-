{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": "public",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/**,public/media/manifest.json,public/img/**,public/css/*.css,public/js/*.js,node_modules/better-sqlite3/package.json,node_modules/better-sqlite3/lib/**,node_modules/better-sqlite3/prebuilds/linux-x64.node}",
      "excludeFiles": "{public/media/photos/**,public/media/depth/**,public/fonts/**,public/js/*.map,public/favicon.*,node_modules/better-sqlite3/prebuilds/darwin-*,node_modules/better-sqlite3/prebuilds/win32-*,node_modules/better-sqlite3/prebuilds/linuxmusl-*}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
