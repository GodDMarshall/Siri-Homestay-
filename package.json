{
  "name": "siri-homestay",
  "version": "1.0.0",
  "description": "Siri Homestay website, booking enquiries and owner admin (Phase 1)",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "node --watch server.js",
    "setup": "node src/db/seed.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.js",
    "build:world": "esbuild src/world/index.js --bundle --format=esm --minify --legal-comments=none --target=es2020 --outfile=public/js/world.js",
    "build:world:dev": "esbuild src/world/index.js --bundle --format=esm --sourcemap --target=es2020 --outfile=public/js/world.js",
    "render": "node scripts/render-views.mjs --out renders --q ultra --w 1600 && python3 scripts/build-renders.py --src renders --out public/media"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@fontsource-variable/anek-kannada": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "three": "^0.187.0"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
